---
import { Icon } from "astro-icon/components";

const githubUrl = import.meta.env.SITE_GITHUB_URL ?? "";
const linkedinUrl = import.meta.env.SITE_LINKEDIN_URL ?? "";

const socials = [
  githubUrl
    ? { href: githubUrl, label: "GitHub", icon: "simple-icons:github" }
    : null,
  linkedinUrl
    ? { href: linkedinUrl, label: "LinkedIn", icon: "simple-icons:linkedin" }
    : null,
].filter((social): social is { href: string; label: string; icon: string } =>
  Boolean(social),
);
---

<footer class="site-footer">
  <div class="container footer-wrap">
    <ul class="footer-links">
      {
        socials.map((social) => (
          <li>
            <a class="footer-link" href={social.href} rel="me">
              <Icon class="footer-icon" name={social.icon} aria-hidden="true" />
              <span>{social.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="footer-copy">© 2026</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-6);
    padding-block: var(--space-4);
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .footer-wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .footer-links {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text-muted);

    &:hover {
      color: var(--color-accent);
      text-decoration: none;
    }
  }

  .footer-icon {
    width: 1.1em;
    height: 1.1em;
  }

  .footer-copy {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .footer-wrap {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
