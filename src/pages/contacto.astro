---
import Base from '../layouts/Base.astro';
import { t, type Locale } from '../i18n/utils';

const locale = (Astro.currentLocale ?? 'es') as Locale;

const siteName = import.meta.env.SITE_NAME ?? 'Portfolio';
const email = import.meta.env.SITE_EMAIL ?? '';
---

<Base title={t(locale, 'meta.contactTitle')} description={t(locale, 'meta.contactDescription', { name: siteName })}>
  <section class="page container">
    <h1>{t(locale, 'contact.title')}</h1>
    <p class="lead">{t(locale, 'contact.lead')}</p>

    <form
      class="contact-form"
      data-contact-form
      data-contact-email={email}
      data-reveal
      novalidate
    >
      <div class="field">
        <label for="name">{t(locale, 'contact.name')}</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="contact-email">{t(locale, 'contact.email')}</label>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          required
        />
      </div>
      <div class="field">
        <label for="subject">{t(locale, 'contact.subject')}</label>
        <input id="subject" name="subject" type="text" required />
      </div>
      <div class="field">
        <label for="message">{t(locale, 'contact.message')}</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>
      <button class="btn btn-primary" type="submit">{t(locale, 'contact.send')}</button>
      <p class="form-note" data-form-note role="status"></p>
    </form>
  </section>
</Base>

<style>
  .field textarea {
    resize: vertical;
    min-height: 5lh;
    max-height: 15lh;
  }
</style>

<script>
  import { t, type Locale } from '../i18n/utils';

  function currentLocale(): Locale {
    return (document.documentElement.getAttribute('data-locale') ?? 'es') as Locale;
  }

  const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]{3,}$/;

  function validateEmail(email: string, note: Element | null) {
    if (!EMAIL_REGEX.test(email)) {
      if (note) {
        note.textContent = t(currentLocale(), 'contact.invalidEmail');
      }
      return false;
    }
    if (note) {
      note.textContent = '';
    }
    return true;
  }

  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector('[data-contact-form]') as HTMLFormElement | null;
    const note = document.querySelector('[data-form-note]');
    const emailInput = document.querySelector('#contact-email') as HTMLInputElement | null;

    emailInput?.addEventListener('blur', () => {
      const value = emailInput.value.trim();
      if (value) {
        validateEmail(value, note);
      }
    });

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = data.get('name');
      const fromEmail = data.get('email');
      const subject = data.get('subject');
      const message = data.get('message');

      if (!name || !fromEmail || !subject || !message) {
        if (note) {
          note.textContent = t(currentLocale(), 'contact.error');
        }
        return;
      }

      if (!validateEmail(String(fromEmail), note)) {
        return;
      }

      const mailto = `mailto:${form.dataset.contactEmail}?subject=${encodeURIComponent(
        String(subject)
      )}&body=${encodeURIComponent(`${String(message)}\n\n— ${String(name)} (${String(fromEmail)})`)}`;

      window.location.href = mailto;
    });
  });
</script>

<style>
  .page {
    max-width: 760px;
    margin-inline: auto;
    padding-block: var(--space-5) var(--space-4);
  }

  .lead {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .contact-form {
    margin-top: var(--space-4);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
  }

  .field label {
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .field input,
  .field textarea {
    font-family: inherit;
    font-size: 1rem;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    color: var(--color-text);
    transition: border-color var(--transition);
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .form-note {
    color: var(--color-text-muted);
  }
</style>
