---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, type Locale } from '../i18n/utils';
import { profileText } from '../i18n/env';

const locale = (Astro.currentLocale ?? 'es') as Locale;

const siteName = import.meta.env.SITE_NAME ?? 'Portfolio';
const siteRole = profileText(locale, 'ROLE');
const siteBio = profileText(locale, 'BIO');
const siteBioShort = siteBio.length > 160 ? siteBio.slice(0, 157) + '…' : siteBio;
const siteObjective = profileText(locale, 'OBJECTIVE');
const siteCvUrl = locale === 'en'
  ? 'https://github.com/user-attachments/files/30900939/CV_Fran_eng.pdf'
  : (import.meta.env.SITE_CV_URL ?? '');
---

<Base title={t(locale, 'meta.homeTitle')} description={siteBioShort}>
  <section class="hero container">
    <h1 class="hero-title">
      {t(locale, 'hero.greeting')} <span class="gradient-text">{siteName}</span>
    </h1>
    {siteRole ? <p class="hero-role">{siteRole}</p> : null}
    {siteObjective ? <p class="hero-objective">{siteObjective}</p> : null}
    <div class="hero-actions">
      <a class="btn btn-primary" href={getRelativeLocaleUrl(locale, 'proyectos')}>{t(locale, 'hero.viewProjects')}</a>
      {siteCvUrl ? (
        <a class="btn btn-secondary" href={siteCvUrl}>
          <Icon class="btn-icon" name="lucide:download" aria-hidden="true" />
          {t(locale, 'hero.downloadCv')}
        </a>
      ) : null}
      <a class="btn btn-secondary" href={getRelativeLocaleUrl(locale, 'contacto')}>{t(locale, 'nav.contact')}</a>
    </div>
  </section>

  <section
    class="tutorials-cta container"
    aria-labelledby="tutorials-cta-title"
    data-gsap="parallax"
  >
    <div>
      <h2 id="tutorials-cta-title">{t(locale, 'cta.tutorialsTitle')}</h2>
      <p>{t(locale, 'cta.tutorialsText')}</p>
    </div>
    <a class="btn btn-primary" href={getRelativeLocaleUrl(locale, 'tutoriales')}>{t(locale, 'cta.viewTutorials')}</a>
  </section>
</Base>

<script>
  import '../scripts/gsap';
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-6) var(--space-5);
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }

  .hero::before,
  .hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(64px);
    opacity: 0.45;
    pointer-events: none;
  }

  .hero::before {
    width: 420px;
    height: 420px;
    top: -140px;
    left: -160px;
    background-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
    animation: hero-float 12s ease-in-out infinite;
  }

  .hero::after {
    width: 380px;
    height: 380px;
    bottom: -140px;
    right: -160px;
    background-color: color-mix(in srgb, #8b5cf6 30%, transparent);
    animation: hero-float 16s ease-in-out infinite reverse;
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }

    50% {
      transform: translate(26px, -20px) scale(1.08);
    }
  }

  .hero-title {
    font-size: clamp(2.5rem, 7vw, 4.25rem);
    margin-bottom: var(--space-2);
  }

  .gradient-text {
    background-image: linear-gradient(120deg, var(--color-accent), #8b5cf6);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-role {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-accent);
    font-weight: 600;
    margin-bottom: var(--space-3);
  }

  .hero-bio {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .hero-objective {
    color: var(--color-text-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    margin-top: var(--space-4);
  }

  .tutorials-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: var(--space-4);
    background-color: var(--color-accent-soft);
    border-radius: var(--radius);
  }

  .tutorials-cta h2 {
    margin-bottom: var(--space-1);
  }

  .tutorials-cta p {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
