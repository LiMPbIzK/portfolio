---
import Base from '../layouts/Base.astro';
import { t, type Locale } from '../i18n/utils';

const locale = (Astro.currentLocale ?? 'es') as Locale;

const siteUser = import.meta.env.SITE_GITHUB_USER ?? '';
---

<Base title={t(locale, 'meta.projectsTitle')} description={t(locale, 'meta.projectsDescription')}>
  <section class="page container">
    <h1 data-reveal>{t(locale, 'projects.title')}</h1>
    <p class="lead" data-reveal>{t(locale, 'projects.lead')}</p>

    <div class="projects-toolbar" data-projects-toolbar hidden>
      <div class="filter-chips" data-filter-chips role="group" aria-label="Filtrar por lenguaje"></div>
      <div class="sort-field">
        <label for="sort-select">{t(locale, 'projects.sort')}</label>
        <select id="sort-select" data-sort-select>
          <option value="updated">{t(locale, 'projects.sortUpdated')}</option>
          <option value="stars">{t(locale, 'projects.sortStars')}</option>
          <option value="name">{t(locale, 'projects.sortName')}</option>
        </select>
      </div>
    </div>

    <div id="projects" class="projects" data-username={siteUser} data-reveal aria-live="polite">
      <p class="projects-status" role="status">{t(locale, 'projects.loading')}</p>
    </div>
  </section>
</Base>

<script>
  import { getRepos } from '../scripts/github';
  import type { GitHubRepo } from '../scripts/github';
  import { t, type Locale, type TranslationKey } from '../i18n/utils';

  function currentLocale(): Locale {
    return (document.documentElement.getAttribute('data-locale') ?? 'es') as Locale;
  }

  let repos: GitHubRepo[] = [];
  let language = 'all';
  let sort = 'updated';

  function getContainer(): HTMLElement | null {
    return document.querySelector('#projects');
  }

  function getToolbar(): HTMLElement | null {
    return document.querySelector('[data-projects-toolbar]');
  }

  function getFilterChips(): HTMLElement | null {
    return document.querySelector('[data-filter-chips]');
  }

  function getSortSelect(): HTMLSelectElement | null {
    return document.querySelector('[data-sort-select]');
  }

  const username = getContainer()?.getAttribute('data-username') ?? '';

  function escapeHtml(value: string): string {
    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function setStatus(message: string): void {
    const container = getContainer();
    if (container) {
      container.innerHTML = `<p class="projects-status" role="status">${escapeHtml(message)}</p>`;
    }
  }

  const arrowSvg =
    '<svg class="card-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg>';

  const customLinks: Record<string, { url: string; labelKey: TranslationKey }> = {
    lexi: { url: 'https://lexi.fmartinezgarcia.com', labelKey: 'projects.app' },
  };

  function projectCard(repo: GitHubRepo): string {
    const extra = customLinks[repo.name];
    return `
      <article class="project-card">
        <h3 class="project-name">
          <a href="${escapeHtml(repo.html_url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(repo.name)}</a>
        </h3>
        ${
          repo.description
            ? `<p class="project-description">${escapeHtml(repo.description)}</p>`
            : ''
        }
        <div class="project-meta">
          ${
            repo.language
              ? `<span class="project-language"><span class="language-dot" aria-hidden="true"></span>${escapeHtml(repo.language)}</span>`
              : ''
          }
          ${
            repo.stargazers_count > 0
              ? `<span aria-label="${escapeHtml(t(currentLocale(), 'projects.stars', { count: repo.stargazers_count }))}">★ ${repo.stargazers_count}</span>`
              : ''
          }
          ${
            repo.forks_count > 0
              ? `<span aria-label="${escapeHtml(t(currentLocale(), 'projects.forks', { count: repo.forks_count }))}">⑂ ${repo.forks_count}</span>`
              : ''
          }
        </div>
        <div class="project-links">
          <a class="btn btn-primary" href="${escapeHtml(repo.html_url)}" target="_blank" rel="noopener noreferrer">${t(currentLocale(), 'projects.code')} ${arrowSvg}</a>
          ${
            extra
              ? `<a class="btn btn-secondary" href="${escapeHtml(extra.url)}" target="_blank" rel="noopener noreferrer">${t(currentLocale(), extra.labelKey)} ${arrowSvg}</a>`
              : ''
          }
          ${
            repo.homepage
              ? `<a class="btn btn-secondary" href="${escapeHtml(repo.homepage)}" target="_blank" rel="noopener noreferrer">${t(currentLocale(), 'projects.demo')} ${arrowSvg}</a>`
              : ''
          }
        </div>
      </article>
    `;
  }

  function renderCards(cards: GitHubRepo[]): void {
    const container = getContainer();
    if (container) {
      container.innerHTML = cards.map(projectCard).join('');
    }
  }

  function render(): void {
    const filtered = repos.filter((repo) => language === 'all' || repo.language === language);
    const sorted = [...filtered].sort((a, b) => {
      if (sort === 'stars') return b.stargazers_count - a.stargazers_count;
      if (sort === 'name') return a.name.localeCompare(b.name);
      return new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime();
    });

    if (sorted.length === 0) {
      setStatus(
        language === 'all'
          ? t(currentLocale(), 'projects.none')
          : t(currentLocale(), 'projects.noneForLang', { lang: language })
      );
      return;
    }
    renderCards(sorted);
  }

  function buildToolbar(): void {
    const toolbar = getToolbar();
    const chips = getFilterChips();
    if (!toolbar || !chips) return;

    const languages = Array.from(new Set(repos.map((repo) => repo.language).filter(Boolean))).sort();
    chips.innerHTML = '';

    const options: [string, string][] = [
      ['all', t(currentLocale(), 'projects.all')],
      ...languages.map((lang) => [lang, lang] as [string, string]),
    ];
    for (const [value, label] of options) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'filter-chip';
      button.textContent = label;
      button.setAttribute('aria-pressed', String(language === value));
      button.addEventListener('click', () => {
        language = value;
        chips.querySelectorAll('button').forEach((btn) => btn.setAttribute('aria-pressed', 'false'));
        button.setAttribute('aria-pressed', 'true');
        render();
      });
      chips.appendChild(button);
    }

    toolbar.hidden = false;
  }

  function bindSort(): void {
    const select = getSortSelect();
    if (!select) return;
    select.addEventListener('change', () => {
      sort = select.value;
      render();
    });
  }

  async function load(): Promise<void> {
    const container = getContainer();
    if (container?.querySelector('.project-card')) return;

    if (!username) {
      setStatus(t(currentLocale(), 'projects.noUser'));
      return;
    }

    try {
      const all = await getRepos(username);
      repos = all.filter((repo) => !repo.fork && !repo.archived);
      if (repos.length === 0) {
        setStatus(t(currentLocale(), 'projects.none'));
        return;
      }
      bindSort();
      buildToolbar();
      render();
    } catch {
      if (container) {
        const retry = document.createElement('button');
        retry.type = 'button';
        retry.className = 'btn btn-secondary';
        retry.textContent = t(currentLocale(), 'projects.retry');
        retry.addEventListener('click', load);

        container.textContent = t(currentLocale(), 'projects.error');
        container.appendChild(retry);
      }
    }
  }

  void load();
  document.addEventListener('astro:after-swap', () => {
    void load();
  });
  document.addEventListener('astro:page-load', () => {
    void load();
  });
</script>

<style>
  .page {
    max-width: 900px;
    margin-inline: auto;
    padding-block: var(--space-5) var(--space-4);
  }

  .lead {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }
</style>
