---
import Base from '../layouts/Base.astro';

const siteUser = import.meta.env.SITE_GITHUB_USER ?? '';
---

<Base title="Proyectos" description="Proyectos alojados en GitHub.">
  <section class="page container">
    <h1 data-reveal>Proyectos</h1>
    <p class="lead" data-reveal>Mis proyectos públicos en GitHub.</p>

    <div class="projects-toolbar" data-projects-toolbar hidden>
      <div class="filter-chips" data-filter-chips role="group" aria-label="Filtrar por lenguaje"></div>
      <div class="sort-field">
        <label for="sort-select">Ordenar</label>
        <select id="sort-select" data-sort-select>
          <option value="updated">Recientes</option>
          <option value="stars">Estrellas</option>
          <option value="name">Nombre</option>
        </select>
      </div>
    </div>

    <div id="projects" class="projects" data-username={siteUser} data-reveal aria-live="polite">
      <p class="projects-status" role="status">Cargando proyectos…</p>
    </div>
  </section>
</Base>

<script>
  import { getRepos } from '../scripts/github';
  import type { GitHubRepo } from '../scripts/github';

  let repos: GitHubRepo[] = [];
  let language = 'all';
  let sort = 'updated';

  function getContainer(): HTMLElement | null {
    return document.querySelector('#projects');
  }

  function getToolbar(): HTMLElement | null {
    return document.querySelector('[data-projects-toolbar]');
  }

  function getFilterChips(): HTMLElement | null {
    return document.querySelector('[data-filter-chips]');
  }

  function getSortSelect(): HTMLSelectElement | null {
    return document.querySelector('[data-sort-select]');
  }

  const username = getContainer()?.getAttribute('data-username') ?? '';

  function escapeHtml(value: string): string {
    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function setStatus(message: string): void {
    const container = getContainer();
    if (container) {
      container.innerHTML = `<p class="projects-status" role="status">${escapeHtml(message)}</p>`;
    }
  }

  const arrowSvg =
    '<svg class="card-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg>';

  function projectCard(repo: GitHubRepo): string {
    return `
      <article class="project-card">
        <h3 class="project-name">
          <a href="${escapeHtml(repo.html_url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(repo.name)}</a>
        </h3>
        ${
          repo.description
            ? `<p class="project-description">${escapeHtml(repo.description)}</p>`
            : ''
        }
        <div class="project-meta">
          ${
            repo.language
              ? `<span class="project-language"><span class="language-dot" aria-hidden="true"></span>${escapeHtml(repo.language)}</span>`
              : ''
          }
          ${repo.stargazers_count > 0 ? `<span aria-label="${repo.stargazers_count} estrellas">★ ${repo.stargazers_count}</span>` : ''}
          ${repo.forks_count > 0 ? `<span aria-label="${repo.forks_count} forks">⑂ ${repo.forks_count}</span>` : ''}
        </div>
        <div class="project-links">
          ${
            repo.homepage
              ? `<a class="btn btn-secondary" href="${escapeHtml(repo.homepage)}" target="_blank" rel="noopener noreferrer">Demo ${arrowSvg}</a>`
              : ''
          }
          <a class="btn btn-primary" href="${escapeHtml(repo.html_url)}" target="_blank" rel="noopener noreferrer">Código ${arrowSvg}</a>
        </div>
      </article>
    `;
  }

  function renderCards(cards: GitHubRepo[]): void {
    const container = getContainer();
    if (container) {
      container.innerHTML = cards.map(projectCard).join('');
    }
  }

  function render(): void {
    const filtered = repos.filter((repo) => language === 'all' || repo.language === language);
    const sorted = [...filtered].sort((a, b) => {
      if (sort === 'stars') return b.stargazers_count - a.stargazers_count;
      if (sort === 'name') return a.name.localeCompare(b.name);
      return new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime();
    });

    if (sorted.length === 0) {
      setStatus(
        language === 'all'
          ? 'Todavía no hay proyectos públicos.'
          : `No hay proyectos en ${escapeHtml(language)}.`
      );
      return;
    }
    renderCards(sorted);
  }

  function buildToolbar(): void {
    const toolbar = getToolbar();
    const chips = getFilterChips();
    if (!toolbar || !chips) return;

    const languages = Array.from(new Set(repos.map((repo) => repo.language).filter(Boolean))).sort();
    chips.innerHTML = '';

    const options: [string, string][] = [['all', 'Todos'], ...languages.map((lang) => [lang, lang] as [string, string])];
    for (const [value, label] of options) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'filter-chip';
      button.textContent = label;
      button.setAttribute('aria-pressed', String(language === value));
      button.addEventListener('click', () => {
        language = value;
        chips.querySelectorAll('button').forEach((btn) => btn.setAttribute('aria-pressed', 'false'));
        button.setAttribute('aria-pressed', 'true');
        render();
      });
      chips.appendChild(button);
    }

    toolbar.hidden = false;
  }

  function bindSort(): void {
    const select = getSortSelect();
    if (!select) return;
    select.addEventListener('change', () => {
      sort = select.value;
      render();
    });
  }

  async function load(): Promise<void> {
    const container = getContainer();
    if (container?.querySelector('.project-card')) return;

    if (!username) {
      setStatus('No se ha configurado el usuario de GitHub.');
      return;
    }

    try {
      const all = await getRepos(username);
      repos = all.filter((repo) => !repo.fork && !repo.archived);
      if (repos.length === 0) {
        setStatus('Todavía no hay proyectos públicos.');
        return;
      }
      bindSort();
      buildToolbar();
      render();
    } catch {
      if (container) {
        const retry = document.createElement('button');
        retry.type = 'button';
        retry.className = 'btn btn-secondary';
        retry.textContent = 'Reintentar';
        retry.addEventListener('click', load);

        container.textContent = 'No se pudieron cargar los proyectos. ';
        container.appendChild(retry);
      }
    }
  }

  void load();
  document.addEventListener('astro:after-swap', () => {
    void load();
  });
  document.addEventListener('astro:page-load', () => {
    void load();
  });
</script>

<style>
  .page {
    max-width: 900px;
    margin-inline: auto;
    padding-block: var(--space-5) var(--space-4);
  }

  .lead {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }
</style>
