---
import Base from '../layouts/Base.astro';
---

<Base title="Proyectos" description="Proyectos alojados en GitHub.">
  <section class="page container">
    <h1>Proyectos</h1>
    <p class="lead">
      Lista de proyectos cargados desde GitHub. Contenido en construcción.
    </p>
  </section>
</Base>

<style>
  .page {
    max-width: 900px;
    margin-inline: auto;
    padding-block: var(--space-5) var(--space-4);
  }

  .lead {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }
</style>
