---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, type Locale, type TranslationKey } from '../i18n/utils';
import { profileText } from '../i18n/env';

const locale = (Astro.currentLocale ?? 'es') as Locale;

const siteName = import.meta.env.SITE_NAME ?? 'Portfolio';
const siteBio = profileText(locale, 'BIO');

const skillGroups: {
  categoryKey: TranslationKey;
  skills: { name?: string; nameKey?: TranslationKey; icon: string | null }[];
}[] = [
  {
    categoryKey: 'about.cat.languages',
    skills: [
      { name: 'Delphi', icon: 'simple-icons:delphi' },
      { name: 'HTML5', icon: 'simple-icons:html5' },
      { name: 'CSS3', icon: 'simple-icons:css3' },
      { name: 'JavaScript', icon: 'simple-icons:javascript' },
      { name: 'Python', icon: 'simple-icons:python' },
    ],
  },
  {
    categoryKey: 'about.cat.databases',
    skills: [{ name: 'Firebird SQL', icon: 'lucide:database' }],
  },
  {
    categoryKey: 'about.cat.tools',
    skills: [
      { name: 'Git', icon: 'simple-icons:git' },
      { name: 'CVS', icon: 'lucide:git-branch' },
      { name: 'FastReport', icon: 'lucide:file-text' },
      { name: 'Jira', icon: 'simple-icons:jira' },
      { name: 'Scrum / Kanban', icon: 'lucide:kanban' },
    ],
  },
  {
    categoryKey: 'about.cat.systems',
    skills: [
      { name: 'Windows', icon: 'simple-icons:windows' },
      { name: 'Linux', icon: 'simple-icons:linux' },
      { name: 'macOS', icon: 'simple-icons:apple' },
      { name: 'LAN / Wi-Fi', icon: 'lucide:wifi' },
      { nameKey: 'about.skill.backups', icon: 'lucide:database-backup' },
    ],
  },
  {
    categoryKey: 'about.cat.hardware',
    skills: [
      { nameKey: 'about.skill.diagnostics', icon: 'lucide:activity' },
      { nameKey: 'about.skill.repair', icon: 'lucide:wrench' },
      { nameKey: 'about.skill.support', icon: 'lucide:headset' },
    ],
  },
];
---

<Base title={t(locale, 'meta.aboutTitle')} description={t(locale, 'meta.aboutDescription', { name: siteName })}>
  <section class="page container">
    <h1 data-reveal>{t(locale, 'about.title')}</h1>
    {siteBio ? <p class="lead" data-reveal>{siteBio}</p> : null}
    <p data-reveal>{t(locale, 'about.intro')}</p>

    <section class="skills" aria-labelledby="skills-title" data-gsap="parallax">
      <h2 id="skills-title">{t(locale, 'about.techTitle')}</h2>
      {
        skillGroups.map((group) => (
          <div class="skill-group" data-reveal>
            <h3 class="skill-group-title">{t(locale, group.categoryKey)}</h3>
            <ul class="skills-list">
              {group.skills.map((skill) => (
                <li class="skill-chip">
                  {skill.icon ? (
                    <Icon class="skill-icon" name={skill.icon} aria-hidden="true" />
                  ) : null}
                  {skill.name ?? t(locale, skill.nameKey!)}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <p>
      {t(locale, 'about.talkText')}{' '}
      <a href={getRelativeLocaleUrl(locale, 'contacto')}>{t(locale, 'about.contactPage')}</a>.
    </p>
  </section>
</Base>

<script>
  import '../scripts/gsap';
</script>

<style>
  .page {
    max-width: 760px;
    margin-inline: auto;
    padding-block: var(--space-5) var(--space-4);
  }

  .lead {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .skills {
    margin-top: var(--space-5);
  }

  .skill-group {
    margin-bottom: var(--space-3);
  }

  .skill-group-title {
    margin-bottom: var(--space-1);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: var(--space-1) var(--space-2);
    background-color: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .skill-icon {
    width: 1em;
    height: 1em;
  }
</style>
