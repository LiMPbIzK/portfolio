---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';

const siteName = import.meta.env.SITE_NAME ?? 'Portfolio';
const siteBio = import.meta.env.SITE_BIO ?? '';
const base = import.meta.env.BASE_URL;

const skillGroups = [
  {
    category: 'Lenguajes y desarrollo',
    skills: [
      { name: 'Delphi', icon: 'simple-icons:delphi' },
      { name: 'HTML5', icon: 'simple-icons:html5' },
      { name: 'CSS3', icon: 'simple-icons:css3' },
      { name: 'JavaScript', icon: 'simple-icons:javascript' },
      { name: 'Python', icon: 'simple-icons:python' },
    ],
  },
  {
    category: 'Bases de datos',
    skills: [{ name: 'Firebird SQL', icon: null }],
  },
  {
    category: 'Herramientas y metodologías',
    skills: [
      { name: 'Git', icon: 'simple-icons:git' },
      { name: 'CVS', icon: null },
      { name: 'FastReport', icon: null },
      { name: 'Jira', icon: 'simple-icons:jira' },
      { name: 'Scrum / Kanban', icon: null },
    ],
  },
  {
    category: 'Sistemas y redes',
    skills: [
      { name: 'Windows', icon: 'simple-icons:windows' },
      { name: 'Linux', icon: 'simple-icons:linux' },
      { name: 'macOS', icon: 'simple-icons:apple' },
      { name: 'LAN / Wi-Fi', icon: null },
      { name: 'Copias de seguridad', icon: null },
    ],
  },
  {
    category: 'Hardware y soporte',
    skills: [
      { name: 'Diagnóstico', icon: null },
      { name: 'Reparación', icon: null },
      { name: 'Soporte técnico', icon: null },
    ],
  },
];
---

<Base title="Sobre mí" description={`Conoce más sobre ${siteName}.`}>
  <section class="page container">
    <h1 data-reveal>Sobre mí</h1>
    {siteBio ? <p class="lead" data-reveal>{siteBio}</p> : null}
    <p data-reveal>
      Me dedico al desarrollo y al soporte técnico informático, con el objetivo
      constante de ampliar mis conocimientos sobre desarrollo de software.
      Este espacio reúne los proyectos en los que voy trabajando.
    </p>

    <section class="skills" aria-labelledby="skills-title" data-gsap="parallax">
      <h2 id="skills-title">Tecnologías</h2>
      {
        skillGroups.map((group) => (
          <div class="skill-group" data-reveal>
            <h3 class="skill-group-title">{group.category}</h3>
            <ul class="skills-list">
              {group.skills.map((skill) => (
                <li class="skill-chip">
                  {skill.icon ? (
                    <Icon class="skill-icon" name={skill.icon} aria-hidden="true" />
                  ) : null}
                  {skill.name}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <p>
      ¿Hablamos? Escríbeme desde la página de{' '}
      <a href={`${base}contacto`}>contacto</a>.
    </p>
  </section>
</Base>

<script>
  import '../scripts/gsap';
</script>

<style>
  .page {
    max-width: 760px;
    margin-inline: auto;
    padding-block: var(--space-5) var(--space-4);
  }

  .lead {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .skills {
    margin-top: var(--space-5);
  }

  .skill-group {
    margin-bottom: var(--space-3);
  }

  .skill-group-title {
    margin-bottom: var(--space-1);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: var(--space-1) var(--space-2);
    background-color: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .skill-icon {
    width: 1em;
    height: 1em;
  }
</style>
