---
import Base from '../layouts/Base.astro';

const siteName = import.meta.env.SITE_NAME ?? 'Portfolio';
const siteBio = import.meta.env.SITE_BIO ?? '';
const base = import.meta.env.BASE_URL;

const skillGroups = [
  {
    category: 'Lenguajes y desarrollo',
    skills: ['Delphi', 'HTML5', 'CSS3', 'JavaScript', 'Python'],
  },
  {
    category: 'Bases de datos',
    skills: ['Firebird SQL'],
  },
  {
    category: 'Herramientas y metodologías',
    skills: ['Git', 'CVS', 'FastReport', 'Jira', 'Scrum / Kanban'],
  },
  {
    category: 'Sistemas y redes',
    skills: ['Windows', 'Linux', 'macOS', 'LAN / Wi-Fi', 'Copias de seguridad'],
  },
  {
    category: 'Hardware y soporte',
    skills: ['Diagnóstico', 'Reparación', 'Soporte técnico'],
  },
];
---

<Base title="Sobre mí" description={`Conoce más sobre ${siteName}.`}>
  <section class="page container">
    <h1>Sobre mí</h1>
    {siteBio ? <p class="lead">{siteBio}</p> : null}
    <p>
      Me dedico al desarrollo y al soporte técnico informático, con el objetivo
      constante de ampliar mis conocimientos sobre desarrollo de software.
      Este espacio reúne los proyectos en los que voy trabajando.
    </p>

    <section class="skills" aria-labelledby="skills-title">
      <h2 id="skills-title">Tecnologías</h2>
      {
        skillGroups.map((group) => (
          <div class="skill-group">
            <h3 class="skill-group-title">{group.category}</h3>
            <ul class="skills-list">
              {group.skills.map((skill) => (
                <li class="skill-chip">{skill}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <p>
      ¿Hablamos? Escríbeme desde la página de{' '}
      <a href={`${base}contacto`}>contacto</a>.
    </p>
  </section>
</Base>

<style>
  .page {
    max-width: 760px;
    margin-inline: auto;
    padding-block: var(--space-5) var(--space-4);
  }

  .lead {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .skills {
    margin-top: var(--space-5);
  }

  .skill-group {
    margin-bottom: var(--space-3);
  }

  .skill-group-title {
    margin-bottom: var(--space-1);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .skill-chip {
    padding: var(--space-1) var(--space-2);
    background-color: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
  }
</style>
