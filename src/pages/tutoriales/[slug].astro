---
import Base from '../../layouts/Base.astro';
import { getPublishedTutorials, getSeriesInfo, normalizeId } from '../../data/tutorials';
import { render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, getLangTag, type Locale } from '../../i18n/utils';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const es = await getPublishedTutorials('es');
  return es.map((entry) => ({
    params: { slug: normalizeId(entry.id) },
  }));
}

const locale = (Astro.currentLocale ?? 'es') as Locale;
const slug = Astro.params.slug ?? '';

const tutorials = await getPublishedTutorials(locale);
let tutorial = tutorials.find((entry) => normalizeId(entry.id) === slug);
if (!tutorial) {
  const es = await getPublishedTutorials('es');
  tutorial = es.find((entry) => normalizeId(entry.id) === slug);
}
if (!tutorial) {
  throw new Error(`Tutorial no encontrado: ${slug}`);
}
const { Content } = await render(tutorial);

const seriesId = tutorial.data.series ?? '';
const seriesInfo = seriesId ? getSeriesInfo(locale, seriesId) : undefined;

const seriesParts = seriesId
  ? tutorials
      .filter((entry) => entry.data.series === seriesId)
      .sort((a, b) => a.data.order - b.data.order)
  : tutorials;

const currentIndex = seriesParts.findIndex((entry) => entry.id === tutorial.id);
const prev = currentIndex > 0 ? seriesParts[currentIndex - 1] : undefined;
const next = currentIndex >= 0 && currentIndex < seriesParts.length - 1 ? seriesParts[currentIndex + 1] : undefined;
const totalParts = seriesParts.length;

const formattedDate = tutorial.data.date.toLocaleDateString(getLangTag(locale), {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={tutorial.data.title} description={tutorial.data.description}>
  <article class="article container" data-reveal>
    <nav class="breadcrumbs" aria-label="Ruta">
      <a href={getRelativeLocaleUrl(locale, 'tutoriales')}>{t(locale, 'tutorials.title')}</a>
      {seriesInfo ? <span aria-hidden="true"> / </span> : null}
      {seriesInfo ? <span>{seriesInfo.title}</span> : null}
    </nav>

    <header class="article-header">
      {tutorial.data.part ? (
        <p class="article-part">
          {t(locale, 'tutorials.partOf', { n: tutorial.data.part, total: totalParts })}
        </p>
      ) : null}
      {
        seriesInfo && totalParts > 1 ? (
          <div class="series-select">
            <label for="series-select">{t(locale, 'tutorials.seriesIndex')}</label>
            <select id="series-select" data-series-select>
              {
                seriesParts.map((part) => (
                  <option
                    value={getRelativeLocaleUrl(locale, `tutoriales/${normalizeId(part.id)}`)}
                    selected={part.id === tutorial.id}
                  >
                    {String(part.data.part ?? '').padStart(2, '0')} · {part.data.title}
                  </option>
                ))
              }
            </select>
          </div>
        ) : null
      }
      <h1>{tutorial.data.title}</h1>
      <p class="article-meta">
        <time datetime={tutorial.data.date.toISOString()}>{formattedDate}</time>
        {tutorial.data.tags.length ? (
          <span class="tags">
            {tutorial.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
          </span>
        ) : null}
      </p>
      <p class="article-description">{tutorial.data.description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="pagination" aria-label="Navegación entre partes">
      {prev ? (
        <a class="pagination-link" href={getRelativeLocaleUrl(locale, `tutoriales/${normalizeId(prev.id)}`)}>
          <span class="pagination-label">{t(locale, 'tutorials.prev')}</span>
          <span class="pagination-title">{prev.data.title}</span>
        </a>
      ) : (
        <span class="pagination-link is-empty" aria-hidden="true"></span>
      )}
      {next ? (
        <a class="pagination-link is-next" href={getRelativeLocaleUrl(locale, `tutoriales/${normalizeId(next.id)}`)}>
          <span class="pagination-label">{t(locale, 'tutorials.next')}</span>
          <span class="pagination-title">{next.data.title}</span>
        </a>
      ) : (
        <span class="pagination-link is-empty" aria-hidden="true"></span>
      )}
    </nav>
  </article>
</Base>

<script>
  import '../../scripts/copy-code';

  document.addEventListener('astro:page-load', () => {
    const select = document.querySelector('[data-series-select]') as HTMLSelectElement | null;
    select?.addEventListener('change', () => {
      if (select.value) {
        window.location.href = select.value;
      }
    });
  });
</script>

<style>
  .article {
    max-width: 820px;
    margin-inline: auto;
    padding-block: var(--space-4) var(--space-5);
  }

  .breadcrumbs {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .article-header {
    margin-bottom: var(--space-4);
  }

  .article-part {
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.875rem;
    margin-bottom: var(--space-1);
  }

  .series-select {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-2);
    font-size: 0.875rem;
    color: var(--color-text-muted);

    select {
      font-family: inherit;
      font-size: 0.875rem;
      max-width: 100%;
      padding: 0.375rem 0.625rem;
      color: var(--color-text);
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      cursor: pointer;
    }
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .tags {
    display: inline-flex;
    gap: var(--space-1);
  }

  .tag {
    background-color: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 0.75rem;
  }

  .article-description {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .pagination {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .pagination-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-width: 48%;
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition:
      border-color var(--transition),
      box-shadow var(--transition);
  }

  .pagination-link:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow);
    text-decoration: none;
  }

  .pagination-link.is-next {
    align-items: flex-end;
    text-align: right;
    margin-left: auto;
  }

  .pagination-link.is-empty {
    visibility: hidden;
  }

  .pagination-label {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .pagination-title {
    font-weight: 600;
    color: var(--color-text);
  }
</style>
