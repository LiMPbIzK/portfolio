---
import Base from '../../layouts/Base.astro';
import { getPublishedTutorials, getSeriesInfo, normalizeId } from '../../data/tutorials';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, getLangTag, type Locale } from '../../i18n/utils';

const locale = (Astro.currentLocale ?? 'es') as Locale;

const siteName = import.meta.env.SITE_NAME ?? 'Portfolio';
const tutorials = await getPublishedTutorials(locale);

const seriesIds = [
  ...new Set(tutorials.map((tutorial) => tutorial.data.series).filter((id): id is string => Boolean(id))),
];

const seriesEntries = seriesIds
  .map((id) => {
    const parts = tutorials
      .filter((entry) => entry.data.series === id)
      .sort((a, b) => a.data.order - b.data.order);
    const info = getSeriesInfo(locale, id);
    const partTags = new Set(parts.flatMap((part) => part.data.tags));
    const tags = info.highlights.filter((highlight) => partTags.has(highlight));
    return { id, info, parts, tags };
  })
  .sort((a, b) => {
    const orderDiff = a.parts[0].data.order - b.parts[0].data.order;
    if (orderDiff !== 0) return orderDiff;
    return a.parts[0].data.date.getTime() - b.parts[0].data.date.getTime();
  });

const standalone = tutorials.filter((tutorial) => !tutorial.data.series);
---

<Base title={t(locale, 'meta.tutorialsTitle')} description={t(locale, 'meta.tutorialsDescription', { name: siteName })}>
  <section class="page container">
    <h1>{t(locale, 'tutorials.title')}</h1>
    <p class="lead">{t(locale, 'tutorials.lead')}</p>

    {
      seriesEntries.length > 1 ? (
        <nav class="series-nav" aria-label="Series">
          {seriesEntries.map((series) => (
            <a class="series-anchor" href={`#series-${series.id}`}>{series.info.title}</a>
          ))}
        </nav>
      ) : null
    }

    {
      seriesEntries.map((series) => (
        <section class="series" aria-labelledby={`series-${series.id}`} data-gsap="parallax">
          <h2 id={`series-${series.id}`} class="series-title">
            {series.info.title}
          </h2>
          <p class="series-description">{series.info.description}</p>
          <p class="series-progress">
            {t(locale, 'tutorials.parts', { count: series.parts.length })} ·{' '}
            {series.parts[0].data.date.toLocaleDateString(getLangTag(locale))}
          </p>
          {
            series.tags.length ? (
              <ul class="series-tags">
                {series.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            ) : null
          }
          <ol class="parts-list">
            {
              series.parts.map((part, index) => (
                <li>
                  <a class="part-card" href={getRelativeLocaleUrl(locale, `tutoriales/${normalizeId(part.id)}`)}>
                    <span class="part-number">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span class="part-body">
                      <span class="part-title">{part.data.title}</span>
                      <span class="part-description">{part.data.description}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>
        </section>
      ))
    }

    {
      standalone.length ? (
        <section class="standalone" aria-labelledby="standalone-title">
          <h2 id="standalone-title">{t(locale, 'tutorials.standaloneTitle')}</h2>
          <ul class="standalone-list">
            {
              standalone.map((tutorial) => (
                <li>
                  <a href={getRelativeLocaleUrl(locale, `tutoriales/${normalizeId(tutorial.id)}`)}>{tutorial.data.title}</a>
                  <p>{tutorial.data.description}</p>
                </li>
              ))
            }
          </ul>
        </section>
      ) : null
    }
  </section>
</Base>

<script>
  import '../../scripts/gsap';
</script>

<style>
  .page {
    max-width: 820px;
    margin-inline: auto;
    padding-block: var(--space-5) var(--space-4);
  }

  .lead {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .series {
    position: relative;
    margin-top: var(--space-5);
    padding: var(--space-4);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);

    &::before {
      content: '';
      position: absolute;
      inset: 0 0 auto 0;
      height: 3px;
      border-radius: var(--radius) var(--radius) 0 0;
      background: linear-gradient(90deg, var(--color-accent), #8b5cf6);
    }
  }

  .series-title {
    font-size: 1.5rem;
    scroll-margin-top: 13rem;
  }

  .series-description {
    color: var(--color-text-muted);
  }

  .series-progress {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  .series-nav {
    position: sticky;
    top: 4.5rem;
    z-index: 40;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-4);
    padding-block: var(--space-1);
    background-color: color-mix(in srgb, var(--color-bg) 90%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .series-anchor {
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    transition:
      border-color var(--transition),
      color var(--transition);

    &:hover {
      border-color: var(--color-accent);
      color: var(--color-accent);
      text-decoration: none;
    }
  }

  .series-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
  }

  .tag {
    background-color: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 0.75rem;
  }

  .parts-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .part-card {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-3);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .part-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .part-number {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-accent);
    font-size: 1.125rem;
  }

  .part-body {
    display: flex;
    flex-direction: column;
  }

  .part-title {
    font-weight: 600;
    color: var(--color-text);
  }

  .part-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .standalone {
    margin-top: var(--space-5);
  }

  .standalone-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
</style>
