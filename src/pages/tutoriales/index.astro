---
import Base from '../../layouts/Base.astro';
import { getPublishedTutorials, SERIES_INFO } from '../../data/tutorials';

const siteName = import.meta.env.SITE_NAME ?? 'Portfolio';
const tutorials = await getPublishedTutorials();

const seriesEntries = Object.keys(SERIES_INFO)
  .map((id) => ({
    id,
    info: SERIES_INFO[id],
    parts: tutorials.filter((t) => t.data.series === id),
  }))
  .filter((s) => s.parts.length > 0);

const standalone = tutorials.filter((t) => !t.data.series);
---

<Base
  title="Tutoriales"
  description={`Guías y autoaprendizaje de ${siteName}: cómo crear una web personal con Astro, GitHub Pages y Cloudflare.`}
>
  <section class="page container">
    <h1>Tutoriales</h1>
    <p class="lead">
      Me defino como una persona curiosa por naturaleza. Aquí comparto lo que
      voy aprendiendo, contado desde mi experiencia, para que tú puedas
      repetirlo.
    </p>

    {
      seriesEntries.map((series) => (
        <section class="series" aria-labelledby={`series-${series.id}`} data-gsap="parallax">
          <h2 id={`series-${series.id}`} class="series-title">
            {series.info.title}
          </h2>
          <p class="series-description">{series.info.description}</p>
          <p class="series-progress">
            {series.parts.length} partes · {series.parts[0].data.date.toLocaleDateString('es-ES')}
          </p>
          <ol class="parts-list">
            {
              series.parts.map((part, index) => (
                <li>
                  <a class="part-card" href={`/tutoriales/${part.id}/`}>
                    <span class="part-number">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <span class="part-body">
                      <span class="part-title">{part.data.title}</span>
                      <span class="part-description">{part.data.description}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>
        </section>
      ))
    }

    {
      standalone.length ? (
        <section class="standalone" aria-labelledby="standalone-title">
          <h2 id="standalone-title">Experiencias sueltas</h2>
          <ul class="standalone-list">
            {
              standalone.map((t) => (
                <li>
                  <a href={`/tutoriales/${t.id}/`}>{t.data.title}</a>
                  <p>{t.data.description}</p>
                </li>
              ))
            }
          </ul>
        </section>
      ) : null
    }
  </section>
</Base>

<script>
  import '../../scripts/gsap';
</script>

<style>
  .page {
    max-width: 820px;
    margin-inline: auto;
    padding-block: var(--space-5) var(--space-4);
  }

  .lead {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .series {
    margin-top: var(--space-5);
  }

  .series-title {
    font-size: 1.5rem;
  }

  .series-description {
    color: var(--color-text-muted);
  }

  .series-progress {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .parts-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .part-card {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-3);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition:
      border-color var(--transition),
      box-shadow var(--transition),
      transform var(--transition);
  }

  .part-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .part-number {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-accent);
    font-size: 1.125rem;
  }

  .part-body {
    display: flex;
    flex-direction: column;
  }

  .part-title {
    font-weight: 600;
    color: var(--color-text);
  }

  .part-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .standalone {
    margin-top: var(--space-5);
  }

  .standalone-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
</style>
